# GEMINI_API_KEY: Required for Gemini API calls.
# Without it the server serves clearly-labelled placeholder output instead of
# pretending an analysis succeeded.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Vision model used to compile sketches. Optional.
# Defaults to gemini-3.6-flash (see src/shared/aiSpec.ts).
# GEMINI_MODEL="gemini-3.6-flash"

# PORT: Port to listen on. Optional, defaults to 3000.
# Cloud Run and most PaaS providers inject this automatically — do not hardcode it.
# PORT=8080

# HOST: Bind address. Optional, defaults to 0.0.0.0.
# HOST="0.0.0.0"

# TRUST_PROXY: Set to "true" when running behind a reverse proxy so per-IP rate
# limiting sees the real client address. Auto-enabled on Cloud Run (K_SERVICE).
# TRUST_PROXY="true"

# Rate limiting for /api/compile-sketch. Optional.
# RATE_LIMIT_WINDOW_MS=300000
# RATE_LIMIT_MAX=20

# GEMINI_TIMEOUT_MS: Abort a compile that hangs. Optional, defaults to 60000.
# GEMINI_TIMEOUT_MS=60000

# APP_URL: The URL where this applet is hosted. Optional; used for self-referential links.
APP_URL="MY_APP_URL"
